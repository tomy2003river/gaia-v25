# OpenWeather API Configuration
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Default city for weather queries
GAIA_CITY=Buenos Aires

# Language preference (es for Spanish, en for English)
GAIA_LANG=es

# TTS Settings
GAIA_TTS_RATE=160
GAIA_TTS_VOICE_ID=

# Memory Settings
GAIA_MEMORY_MAXLEN=200
GAIA_MEMORY_DECAY=0.95

# Cache Settings
GAIA_CACHE_TTL=1800

# Logging
GAIA_LOG_LEVEL=INFO
GAIA_LOG_FILE=logs/gaia.log
